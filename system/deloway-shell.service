[Unit]
Description=Deloway Fluent Desktop Shell
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/quickshell -p %h/.config/deloway/shell
Restart=on-failure
RestartSec=1s
Environment=QT_QUICK_CONTROLS_STYLE=Basic

[Install]
WantedBy=graphical-session.target
