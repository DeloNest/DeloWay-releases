#!/bin/sh
# DeloWay (install.sh): let clients of a NetworkManager hotspot — any connection with
# ipv4.method=shared — get an address and reach the internet, while it is up.
#
# NetworkManager's shared mode runs dnsmasq (DHCP + DNS) and does the NAT, but a host
# firewall can still stop it:
#   * ufw (default input/forward policy DROP) drops the clients' DHCP and DNS requests —
#     it only lets DHCP *replies* in, for this computer's own client — and their
#     forwarded traffic: phones join the network and never get an address.
#   * Docker sets the FORWARD policy to DROP and exempts only its own bridges: clients
#     get an address but no internet. Docker's documented hook is the DOCKER-USER chain.
# The rules below go into those tools' own user chains, only for the hotspot interface,
# and are removed when the hotspot goes down. (`ufw reload` flushes them; restarting the
# hotspot puts them back.)
IFACE="$1"
ACTION="$2"

[ -n "$IFACE" ] && [ -n "$CONNECTION_UUID" ] || exit 0
command -v iptables >/dev/null 2>&1 || exit 0
[ "$(nmcli -g ipv4.method connection show "$CONNECTION_UUID" 2>/dev/null)" = "shared" ] || exit 0

# rule CHAIN RULE… — add on up (once, at the top), remove on down; skipped when the
# chain does not exist (that firewall is not in use).
rule() {
    chain="$1"; shift
    iptables -n -L "$chain" >/dev/null 2>&1 || return 0
    case "$ACTION" in
        up)   iptables -C "$chain" "$@" 2>/dev/null || iptables -I "$chain" 1 "$@" ;;
        down) iptables -D "$chain" "$@" 2>/dev/null ;;
    esac
}

case "$ACTION" in
    up|down)
        # ufw: DHCP and DNS to this computer's dnsmasq, and forwarding both ways.
        rule ufw-user-input -i "$IFACE" -p udp --dport 67 -j ACCEPT
        rule ufw-user-input -i "$IFACE" -p udp --dport 53 -j ACCEPT
        rule ufw-user-input -i "$IFACE" -p tcp --dport 53 -j ACCEPT
        rule ufw-user-forward -i "$IFACE" -j ACCEPT
        rule ufw-user-forward -o "$IFACE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
        # Docker
        rule DOCKER-USER -i "$IFACE" -j ACCEPT
        rule DOCKER-USER -o "$IFACE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
        ;;
esac
exit 0
