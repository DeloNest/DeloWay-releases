#!/usr/bin/env bash
# ==============================================================================
# DeloOS / Deloway Desktop Session Wrapper
# Launches Hyprland compositor configured with Deloway Fluent Shell
# ==============================================================================

set -e

# Resolve symlinks (~/.local/bin and /usr/local/bin hold links to this file), so the
# repo is found wherever it was cloned.
SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
if [ -d "$SCRIPT_DIR/../shell" ]; then
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
elif [ -d "/usr/share/deloway/shell" ]; then
    PROJECT_ROOT="/usr/share/deloway"
else
    PROJECT_ROOT="${DELOWAY_DIR:-$HOME/Projects/Deloway}"
fi

# ------------------------------------------------------------------------------
# 1. Wayland & Desktop Environment Variables
# ------------------------------------------------------------------------------
export XDG_CURRENT_DESKTOP="Hyprland:DeloWay"
export XDG_SESSION_DESKTOP="DeloWay"
export XDG_SESSION_TYPE="wayland"

# Toolkit backend preferences
export QT_QPA_PLATFORM="wayland;xcb"
export QT_WAYLAND_DISABLE_WINDOWDECORATION="1"
export QT_AUTO_SCREEN_SCALE_FACTOR="1"
export QT_QUICK_CONTROLS_STYLE="Basic"

export GDK_BACKEND="wayland,x11,*"
export MOZ_ENABLE_WAYLAND="1"
export SDL_VIDEODRIVER="wayland"
export CLUTTER_BACKEND="wayland"
export ELECTRON_OZONE_PLATFORM_HINT="auto"

# Deloway Paths
export DELOWAY_DIR="${DELOWAY_DIR:-$PROJECT_ROOT}"   # read by the shell, delo-app and helpers
export DELOWAY_HOME="${DELOWAY_HOME:-$DELOWAY_DIR}"  # legacy alias
export DELOWAY_CONFIG="${DELOWAY_CONFIG:-$HOME/.config/deloway/deloway.json}"

# The UI language for the whole session from its first process. Set only later (by the
# shell, into Hyprland), it missed the shell itself — so everything the shell started
# (App Drawer, desktop files) came up in English while shortcuts, started by Hyprland,
# were Arabic. Same values as scripts/deloway-locale-apply.py.
UI_LANG=$(jq -r '.system.uiLanguage // "ar"' "$DELOWAY_CONFIG" 2>/dev/null || echo ar)
if [ "$UI_LANG" = "en" ]; then
    export LANGUAGE="en_US:en"
else
    export LANGUAGE="ar:en"
fi
# Digits in Qt/KDE apps (Settings → Apps → Number Format): Eastern ٠١٢٣ come from an
# Arabic LC_NUMERIC, Western 0123 from en_US.
if [ "$(jq -r '.system.numberFormat // "western"' "$DELOWAY_CONFIG" 2>/dev/null)" = "eastern" ] \
        && locale -a 2>/dev/null | grep -qi '^ar_SA.utf8$'; then
    export LC_NUMERIC="ar_SA.UTF-8"
else
    export LC_NUMERIC="en_US.UTF-8"
fi

# Ensure user directories exist
mkdir -p "$HOME/.config/deloway" "$HOME/.local/share/applications" "$HOME/Desktop"

# ------------------------------------------------------------------------------
# 2. Compositor Configuration Resolution (Completely isolated from ~/.config/hypr)
# ------------------------------------------------------------------------------
HYPR_CONF="$HOME/.config/deloway/hyprland.conf"
if [ ! -f "$HYPR_CONF" ]; then
    HYPR_CONF="$DELOWAY_DIR/config/hyprland.conf"
fi

# ------------------------------------------------------------------------------
# 3. Launch Hyprland Compositor
# ------------------------------------------------------------------------------
echo "==> Starting Deloway Session using configuration: $HYPR_CONF"
exec Hyprland -c "$HYPR_CONF"
