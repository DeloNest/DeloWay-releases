#!/usr/bin/env bash
# ==============================================================================
# DeloWay Abstraction Dispatcher (delo-app)
# Transparently launches user-selected default applications with appropriate flags.
# ==============================================================================

CATEGORY="${1:-terminal}"
shift || true

CONFIG_FILE="${DELOWAY_CONFIG:-$HOME/.config/deloway/deloway.json}"
# Repo root: env first, else this script's real location (it is symlinked into ~/.local/bin).
DELOWAY_DIR="${DELOWAY_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"

get_default_app() {
    local cat="$1"
    local fallback="$2"
    if [ -f "$CONFIG_FILE" ]; then
        if command -v jq >/dev/null 2>&1; then
            local val
            val=$(jq -r ".defaultApps[\"$cat\"] // .[\"$cat\"] // empty" "$CONFIG_FILE" 2>/dev/null)
            if [ -n "$val" ] && [ "$val" != "null" ]; then
                echo "$val"
                return
            fi
        fi
        local val_grep
        val_grep=$(grep -oE "\"$cat\"[[:space:]]*:[[:space:]]*\"[^\"]+\"" "$CONFIG_FILE" 2>/dev/null | head -n1 | sed -E 's/.*"([^"]+)"$/\1/')
        if [ -n "$val_grep" ]; then
            echo "$val_grep"
            return
        fi
    fi
    echo "$fallback"
}

# launch APP [args…] — runs an executable, or a desktop-entry id (e.g. org.gnome.Nautilus)
# via gtk-launch. Returns 1 if neither exists, so callers can fall back.
# (A failed `exec` exits a non-interactive shell, which made `exec a || exec b` chains dead code.)
launch() {
    local app="$1"; shift
    [ -z "$app" ] && return 1
    if command -v "$app" >/dev/null 2>&1; then
        exec "$app" "$@"
    fi
    local id="${app%.desktop}"
    for d in "$HOME/.local/share/applications" /usr/local/share/applications /usr/share/applications /var/lib/flatpak/exports/share/applications; do
        if [ -f "$d/$id.desktop" ]; then
            exec gtk-launch "$id" "$@"
        fi
    done
    return 1
}

case "$CATEGORY" in
    terminal|term)
        APP=$(get_default_app "terminal" "kitty")
        case "$APP" in
            kitty)
                if [ -f "$DELOWAY_DIR/config/kitty/kitty.conf" ]; then
                    # Config directory (not --config) so the *-theme.auto.conf files load too.
                    KITTY_CONFIG_DIRECTORY="$DELOWAY_DIR/config/kitty" exec kitty "$@"
                else
                    exec kitty "$@"
                fi
                ;;
            ghostty)
                if [ -f "$DELOWAY_DIR/config/ghostty.conf" ]; then
                    exec ghostty --config-file="$DELOWAY_DIR/config/ghostty.conf" "$@"
                else
                    exec ghostty "$@"
                fi
                ;;
            alacritty)
                if [ -f "$DELOWAY_DIR/config/alacritty.toml" ]; then
                    exec alacritty --config-file "$DELOWAY_DIR/config/alacritty.toml" "$@"
                else
                    exec alacritty "$@"
                fi
                ;;
            foot)
                if [ -f "$DELOWAY_DIR/config/foot.ini" ]; then
                    exec foot -c "$DELOWAY_DIR/config/foot.ini" "$@"
                else
                    exec foot "$@"
                fi
                ;;
            *)
                launch "$APP" "$@" || launch kitty "$@"
                ;;
        esac
        ;;

    browser|web)
        APP=$(get_default_app "browser" "brave")
        case "$APP" in
            brave|brave-browser)
                launch brave "$@" || launch brave-browser "$@" || exec xdg-open "${1:-https://}"
                ;;
            firefox)
                exec firefox "$@"
                ;;
            zen|zen-browser)
                launch zen-browser "$@" || launch zen "$@" || exec xdg-open "${1:-https://}"
                ;;
            chromium|chrome)
                launch chromium "$@" || launch google-chrome-stable "$@" || exec xdg-open "${1:-https://}"
                ;;
            *)
                launch "$APP" "$@" || exec xdg-open "${1:-https://}"
                ;;
        esac
        ;;

    files|filemanager)
        APP=$(get_default_app "fileManager" "thunar")
        launch "$APP" "$@" || launch thunar "$@" || exec xdg-open "${1:-$HOME}"
        ;;

    editor|text)
        APP=$(get_default_app "editor" "gnome-text-editor")
        launch "$APP" "$@" || launch gnome-text-editor "$@" || launch gedit "$@" || launch mousepad "$@" || exec "$0" terminal -e nano "$@"
        ;;

    monitor|taskmanager)
        APP=$(get_default_app "monitor" "missioncenter")
        launch "$APP" "$@" || launch missioncenter "$@" || launch gnome-system-monitor "$@" || exec "$0" terminal -e btop
        ;;

    mixer|audio)
        APP=$(get_default_app "mixer" "pavucontrol")
        launch "$APP" "$@" || launch pwvucontrol "$@" || launch pavucontrol "$@"
        ;;

    *)
        echo "Usage: delo-app {terminal|browser|files|editor|monitor|mixer} [args...]"
        exit 1
        ;;
esac
