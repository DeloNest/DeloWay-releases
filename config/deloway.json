{
  "theme": {
    "mode": "dark",
    "wallpaper": "",
    "fontSizeScale": 1.25,
    "transparencyLevel": 3,
    "elementRadius": 8,
    "performanceTier": 1
  },
  "desktop": {
    "mode": "clean",
    "showIcons": true,
    "widgetPositions": {},
    "enabledWidgets": [
      "clock",
      "weather",
      "system_monitor"
    ]
  },
  "dock": {
    "position": "bottom",
    "autoHide": false,
    "iconSize": 56,
    "showUnderline": true,
    "pinnedApps": [
      "brave-browser",
      "kitty",
      "thunar"
    ]
  },
  "topBar": {
    "showBrand": true,
    "showWorkspaces": true,
    "clockFormat": "12h",
    "workspacesCount": 5
  },
  "windows": {
    "activeBorder": "#ffffff",
    "inactiveBorder": "#444444",
    "gapsIn": 6,
    "gapsOut": 10,
    "rounding": 8
  },
  "notifications": {
    "dnd": false,
    "timeout": 5000,
    "sound": false
  },
  "power": {
    "profile": "performance",
    "sleepTimeout": 30
  },
  "defaultApps": {
    "browser": "brave",
    "terminal": "kitty",
    "fileManager": "thunar",
    "editor": "org.gnome.TextEditor"
  },
  "system": {
    "uiLanguage": "ar",
    "keyboardLayouts": [
      "us",
      "ara"
    ]
  },
  "music": {
    "preferredPlayer": "auto",
    "launchTarget": {
      "type": "app",
      "value": "spotify",
      "webApp": false
    }
  },
  "setupCompleted": false
}
